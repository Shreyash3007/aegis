{
  "$schema": "aegis-routing-v1",
  "version": "0.10.0-development",
  "source_lock": "superpowers.lock.json",
  "law": [
    "Agents never invoke external blades directly and never talk agent-to-agent.",
    "A phase lists allowed blades. The lane worker runs the blade inside an `aegis exec` recorded run.",
    "Blade output returns to the phase gate with evidence (file:line/tool output) or is stamped INFERRED/UNMEASURED/BLOCKED.",
    "Trigger collisions across blades fail `aegis lint-skills`. One concept per blade; link, never copy."
  ],
  "chain_types": {
    "thin": "flow shaping (mattpocock shape): ordered steps, cheap, no gate power",
    "thick": "rigor gate (addyosmani shape): binary verdict, evidence-attached, can refuse the lane"
  },
  "blades": [
    { "name": "agent-reach", "phase": "01-discover", "role": "research", "chain": "thin",
      "triggers": ["web research", "social lookup", "URL read"], "not_triggers": ["write code", "judge output"] },
    { "name": "last30days", "phase": "01-discover", "role": "research", "chain": "thin",
      "triggers": ["recent topic brief", "last-30-days scan"], "not_triggers": ["evergreen docs", "code"] },
    { "name": "deep-research", "phase": "01-discover", "role": "research", "chain": "thin",
      "triggers": ["autonomous research report"], "not_triggers": ["quick lookup"] },
    { "name": "research-ops", "phase": "01-discover", "role": "research", "chain": "thin",
      "triggers": ["evidence-led comparison", "enrichment"], "not_triggers": ["implementation"] },
    { "name": "archify", "phase": "02-architect", "role": "diagram", "chain": "thin",
      "triggers": ["architecture diagram", "sequence diagram", "HTML diagram export"], "not_triggers": ["numeric charts"] },
    { "name": "gitnexus-exploring", "phase": "02-architect", "role": "code-graph", "chain": "thin",
      "triggers": ["how does X work", "trace execution flow"], "not_triggers": ["edit code"] },
    { "name": "terminal-ops", "phase": "04-build", "role": "execution-evidence", "chain": "thin",
      "triggers": ["run repo command", "prove what was executed"], "not_triggers": ["unverified claims"] },
    { "name": "systematic-debugging", "phase": "05-validate", "role": "debug", "chain": "thick",
      "source": "superpowers.lock.json#systematic-debugging",
      "triggers": ["bug", "test failure", "unexpected behavior"], "not_triggers": ["proposing fixes before root cause"] },
    { "name": "test-driven-development", "phase": "04-build", "role": "tdd", "chain": "thin",
      "source": "superpowers.lock.json#test-driven-development",
      "triggers": ["new logic", "bug fix", "behavior change"], "not_triggers": ["shipping without a failing test first"] },
    { "name": "verification-loop", "phase": "05-validate", "role": "verify", "chain": "thick",
      "triggers": ["pre-PR check", "post-feature verification"], "not_triggers": ["declaring done without evidence"] },
    { "name": "lint-and-validate", "phase": "05-validate", "role": "lint", "chain": "thick",
      "triggers": ["lint and typecheck gate"], "not_triggers": ["claiming checks ran when they did not"] },
    { "name": "browser-qa", "phase": "05-validate", "role": "e2e", "chain": "thick",
      "triggers": ["post-deploy UI check", "responsive + a11y audit"], "not_triggers": ["unit tests"] },
    { "name": "chrome-use", "phase": "05-validate", "role": "browser", "chain": "thin",
      "triggers": ["live web verify", "authenticated browse", "screenshot"], "not_triggers": ["static claims about live pages"] },
    { "name": "open-computer-use", "phase": "05-validate", "role": "os-verify", "chain": "thin",
      "triggers": ["native app verify", "pixel-region check"], "not_triggers": ["headless-only assertions"] },
    { "name": "brooks-lint", "phase": "05-validate", "role": "design-review", "chain": "thick",
      "triggers": ["coupling smell", "decay risk", "structural review"], "not_triggers": ["style nitpicks"] },
    { "name": "unslop", "phase": "05-validate", "role": "slop-strip", "chain": "thin",
      "triggers": ["strip AI writing patterns before publish"], "not_triggers": ["changing meaning"] },
    { "name": "humanizer", "phase": "05-validate", "role": "prose-review", "chain": "thin",
      "triggers": ["de-AI prose pass"], "not_triggers": ["code"] },
    { "name": "scroll-craft", "phase": "prototype", "role": "landing-demo", "chain": "thin",
      "triggers": ["premium scroll demo", "HTML visual direction lock"], "not_triggers": ["production build pre-approval"] },
    { "name": "image-use", "phase": "prototype", "role": "demo-assets", "chain": "thin",
      "triggers": ["demo illustration", "hero mock"], "not_triggers": ["production assets pre-approval"] },
    { "name": "tastegate", "phase": "05-validate", "role": "ui-gate", "chain": "thick",
      "triggers": ["frontend looks designed not generated", "browser proof"], "not_triggers": ["taste without render"] },
    { "name": "jev-use", "phase": "judgment-ring", "role": "judge", "chain": "thick",
      "triggers": ["did it work", "which option", "how risky", "safe to run"], "not_triggers": ["producing content", "writing code"],
      "wiring": "typed Choice/Noul/Score behind TYPESAFE_API_KEY flag; no key = degraded mode, must announce itself" },
    { "name": "brainstorming", "phase": "01-discover", "role": "discovery-craft", "chain": "thin",
      "source": "superpowers.lock.json#brainstorming", "triggers": ["product discovery alternatives"], "not_triggers": ["second pipeline authority"] },
    { "name": "requesting-code-review", "phase": "06-orchestrate", "role": "review-craft", "chain": "thin",
      "source": "superpowers.lock.json#requesting-code-review", "triggers": ["isolated contract-bound reviewer"], "not_triggers": ["approve human gates"] },
    { "name": "using-git-worktrees", "phase": "04-build", "role": "isolation-craft", "chain": "thin",
      "source": "superpowers.lock.json#using-git-worktrees", "triggers": ["slice isolation baseline"], "not_triggers": ["unregistered worktrees"] },
    { "name": "verification-before-completion", "phase": "05-validate", "role": "verification-craft", "chain": "thin",
      "source": "superpowers.lock.json#verification-before-completion", "triggers": ["completion evidence checkpoint"], "not_triggers": ["trust a reported success"] }
  ],
  "missing_with_fallback": [
    { "name": "typesafe-ai", "fallback": "direct TypeSafe HTTPS from CLI (Wave 5) + jev-use MCP when present; never block on the skill file" },
    { "name": "playwright", "fallback": "browser-qa + chrome-use for e2e; record which backend produced the evidence" },
    { "name": "anti-slop", "fallback": "unslop + brooks-lint + `aegis lint-skills` budgets/line-ratchet at merge" }
  ],
  "install_policy": "No further global installs until the store is pruned to the allowlist and counts are verified. New blades are vendored as routing entries with status, never bulk-installed."
}
